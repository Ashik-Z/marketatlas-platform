diff --git a/marketatlas-ui/src/main/java/com/marketatlas/ui/api/ApiClient.java b/marketatlas-ui/src/main/java/com/marketatlas/ui/api/ApiClient.java
index 6a25426..99ab85e 100644
--- a/marketatlas-ui/src/main/java/com/marketatlas/ui/api/ApiClient.java
+++ b/marketatlas-ui/src/main/java/com/marketatlas/ui/api/ApiClient.java
@@ -47,6 +47,18 @@ public class ApiClient {
         }
     }
 
+    /**
+     * Fire-and-forget request that wakes a sleeping API (free hosting stops it when idle).
+     * Never throws; the answer is ignored.
+     */
+    public void warmUp() {
+        try {
+            rest.get().uri("/api/assets").retrieve().toBodilessEntity();
+        } catch (RuntimeException ignored) {
+            // best effort only
+        }
+    }
+
     /** Verifies credentials with a cheap authenticated call; returns normally only on success. */
     public void checkLogin(String username, String password) {
         try {
@@ -294,6 +306,8 @@ public class ApiClient {
             case 409 -> new ApiException(ApiException.Kind.DUPLICATE_USER, "That username is not available.", null);
             case 429 -> new ApiException(ApiException.Kind.RATE_LIMITED, "Too many attempts. Please wait and try again.",
                     retryAfter(e));
+            case 502, 503, 504 -> new ApiException(ApiException.Kind.UNAVAILABLE,
+                    "The server is waking up, which can take up to 3 minutes. Please try again shortly.", null);
             default -> new ApiException(ApiException.Kind.UNAVAILABLE, "The MarketAtlas API returned an error (" + status + ").", null);
         };
     }
diff --git a/marketatlas-ui/src/test/java/com/marketatlas/ui/api/MeClientTest.java b/marketatlas-ui/src/test/java/com/marketatlas/ui/api/MeClientTest.java
index 882778a..44721ac 100644
--- a/marketatlas-ui/src/test/java/com/marketatlas/ui/api/MeClientTest.java
+++ b/marketatlas-ui/src/test/java/com/marketatlas/ui/api/MeClientTest.java
@@ -61,4 +61,26 @@ class MeClientTest {
         ApiException e = assertThrows(ApiException.class, () -> client.me("Basic nope"));
         assertEquals(ApiException.Kind.INVALID_CREDENTIALS, e.kind());
     }
+
+    @Test
+    void aSleepingApiIsReportedAsWakingUp() {
+        for (HttpStatus status : new HttpStatus[] {HttpStatus.BAD_GATEWAY, HttpStatus.SERVICE_UNAVAILABLE, HttpStatus.GATEWAY_TIMEOUT}) {
+            server.reset();
+            server.expect(requestTo("http://api.test/api/me")).andRespond(withStatus(status));
+
+            ApiException ex = assertThrows(ApiException.class, () -> client.me("Basic abc"));
+
+            assertEquals(ApiException.Kind.UNAVAILABLE, ex.kind());
+            assertTrue(ex.getMessage().contains("waking up"));
+        }
+    }
+
+    @Test
+    void warmUpNeverThrows() {
+        server.expect(requestTo("http://api.test/api/assets")).andRespond(withStatus(HttpStatus.BAD_GATEWAY));
+
+        client.warmUp();
+
+        server.verify();
+    }
 }
